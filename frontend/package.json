{
  "name": "vertex-portfolio-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:website": "tsc -b && vite build --config src/pages/website/tunnel.vite.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:website": "vite preview --config src/pages/website/tunnel.vite.config.ts",
    "share:website": "powershell -NoProfile -ExecutionPolicy Bypass -File src/pages/website/start-tunnel.ps1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
